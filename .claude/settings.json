{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(curl:*)",
      "Bash(netstat:*)",
      "Bash(sleep:*)",
      "Bash(until:*)",
      "Bash(test:*)",
      "Bash(true:*)",
      "Bash(python:*)",
      "Bash(node:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(npx:*)",
      "Bash(tsc:*)",
      "Bash(vite:*)",
      "Bash(playwright:*)",
      "Bash(./node_modules/.bin/:*)",
      "Bash(powershell.exe -Command Stop-Process:*)",
      "PowerShell(git:*)",
      "PowerShell(gh:*)",
      "PowerShell(bun:*)",
      "PowerShell(bunx:*)",
      "PowerShell(npx:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
